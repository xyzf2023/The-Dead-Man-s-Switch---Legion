  <RoyalTitlePermitDef>
    <defName>DMSL_RoyalAid_Emp</defName>
    <label>呼叫EMP脉冲弹</label>
    <description>向殖民舰队呼叫一次EMP脉冲弹投放。将向目标地点投放一颗电子脉冲弹，强大的电磁脉冲将瘫痪所有接触的用电器、炮台和机械体，并灼烧所有机械体的核心处理器。\n注意此脉冲没有敌我识别功能，谨防误伤友方。</description>
    <workerClass>DMS_Legion.RoyalPermits.RoyalTitlePermitWorker_AerialSupport</workerClass>
    <faction>DMS_Army</faction>
    <minTitle>DMS_WarrantOfficer</minTitle>
    <permitPointCost>2</permitPointCost>
    <uiPosition>(0,8)</uiPosition>
    <cooldownDays>3</cooldownDays>
    <royalAid>
      <favorCost>3</favorCost>
    </royalAid>
    <modExtensions>
      <li Class="DMS_Legion.RoyalPermits.RoyalTitlePermitExtension_AerialSupport">
        <aerialSupportTypeDefName>DMSL_AerialSupport_Emp</aerialSupportTypeDefName>
      </li>
    </modExtensions>
  </RoyalTitlePermitDef>

