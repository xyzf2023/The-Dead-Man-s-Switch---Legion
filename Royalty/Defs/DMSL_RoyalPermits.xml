  <RoyalTitlePermitDef>
    <defName>DMSL_RoyalAid_AttackAircraftBombing</defName>
    <label>呼叫攻击机轰炸</label>
    <description>向殖民舰队呼叫一次攻击机轰炸。将命令麻雀执行一次轰炸任务。你需要传入两个坐标，随后麻雀将在这两个坐标间投放共计五枚小型炸弹。\n\n（如果你加载了CE，此支援会被替换为攻击机轰炸）</description>
    <workerClass>DMS_Legion.RoyalPermits.RoyalTitlePermitWorker_AerialSupport</workerClass>
    <faction>DMS_Army</faction>
    <minTitle>DMS_WarrantOfficer</minTitle>
    <permitPointCost>1</permitPointCost>
    <uiPosition>(0,9)</uiPosition>
    <cooldownDays>12</cooldownDays>
    <royalAid>
      <favorCost>10</favorCost>
    </royalAid>
    <modExtensions>
      <li Class="DMS_Legion.RoyalPermits.RoyalTitlePermitExtension_AerialSupport">
        <aerialSupportTypeDefName>DMSL_AerialSupport_AttackAircraftBombing</aerialSupportTypeDefName>
      </li>
    </modExtensions>
  </RoyalTitlePermitDef>

