  <RoyalTitlePermitDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>DMSL_Join_AXF12OffsetConfig</defName>
    <label>扩编AXF-12</label>
    <description>向殖民舰队申请调配一架AXF-12「偏构」垂直起降战斗机。这架战斗机将归你的殖民地所有。</description>
    <workerClass>DMS_Legion.RoyalPermits.RoyalTitlePermitWorker_RewardAXF12</workerClass>
    <faction>DMS_Army</faction> 
    <minTitle>DMS_Brigadier</minTitle> <!-- 最低头衔，准将及以上可解锁 -->
    <!--<prerequisite>DMS_Join_Shuttle</prerequisite>  前置 -->
    <permitPointCost>3</permitPointCost> <!-- 解锁消耗的许可点数 -->
    <uiPosition>(6,6)</uiPosition> <!-- 扩编轨道运输机正右方，其坐标为 (6,5) -->
    <cooldownDays>150</cooldownDays>
    <royalAid>
      <favorCost>30</favorCost> <!-- 每次使用消耗的好感度 -->
      <targetingRange>44.9</targetingRange> <!-- 选落点时的最大距离（格） -->
      <targetingRequireLOS>false</targetingRequireLOS> <!-- 选落点是否要求视线，false 允许选雾区 -->
    </royalAid>
  </RoyalTitlePermitDef>
</Defs>
