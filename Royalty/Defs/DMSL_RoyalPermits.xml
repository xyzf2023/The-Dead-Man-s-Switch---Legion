  <RoyalTitlePermitDef>
    <defName>DMSL_RoyalAid_Smoke</defName>
    <label>呼叫烟雾弹</label>
    <description>向殖民舰队呼叫一次烟雾弹投放。</description>
    <workerClass>DMS_Legion.RoyalPermits.RoyalTitlePermitWorker_AerialSupport</workerClass>
    <faction>DMS_Army</faction>
    <minTitle>DMS_Private</minTitle>
    <permitPointCost>1</permitPointCost>
    <uiPosition>(0,0)</uiPosition>
    <cooldownDays>2</cooldownDays>
    <royalAid>
      <favorCost>1</favorCost>
    </royalAid>
    <modExtensions>
      <li Class="DMS_Legion.RoyalPermits.RoyalTitlePermitExtension_AerialSupport">
        <aerialSupportTypeDefName>DMSL_AerialSupport_Smoke</aerialSupportTypeDefName>
      </li>
    </modExtensions>
  </RoyalTitlePermitDef>

  
