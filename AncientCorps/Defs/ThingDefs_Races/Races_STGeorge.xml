<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 定义STGeorge机甲的实体 -->
  <ThingDef ParentName="BaseAutomatroidRace">
    <!-- 机甲的内部标识符 -->
    <defName>DMSL_Mech_STGeorge</defName>
    <!-- 显示名称 -->
    <label>圣乔治</label>
    <!-- 机甲描述 -->
    <description>一款由步行机地盘为主的自行火炮，打击范围可以覆盖全图。\n\nM977A17圣乔治是一款服役了超过75年的自行火炮系统，有着超过15种的改进型号，它是源于苏联解体后，美国陆军由两级对抗逐渐转变成反恐战争所研制的装备，其设计的核心目的就是在72小时之内由战略运输机部署至全球任意热点地区。其所搭载的数据链系统与自动装弹机配合强劲的动力包系统能做到在被反炮兵雷达侦测之前，执行炮击任务并撤离的需求。在第三次世界大战的俄乌前线，圣乔治也被作为援助派往乌克兰与苏联军队对抗……</description>

    <descriptionHyperlinks>
      <ThingDef>DMSL_Gun_M777A</ThingDef>
    </descriptionHyperlinks>

    <!-- 基础属性 -->
    <statBases>
      <MoveSpeed>4.2</MoveSpeed> <!-- 移动速度 -->
      <ArmorRating_Sharp>1.5</ArmorRating_Sharp><!-- 锐器抗性 -->
      <ArmorRating_Blunt>1.5</ArmorRating_Blunt><!-- 钝器抗性 -->
      <ArmorRating_Heat>2</ArmorRating_Heat>  <!-- 热能抗性 -->
      <StaggerDurationFactor>0</StaggerDurationFactor> <!-- 击退时间因子 -->
      <ShootingAccuracyPawn>1</ShootingAccuracyPawn> <!-- 射击精度 -->
      <BandwidthCost MayRequire="Ludeon.Rimworld.Biotech">6</BandwidthCost>        <!-- 带宽消耗（需要Biotech DLC）-->
      <WastepacksPerRecharge MayRequire="Ludeon.Rimworld.Biotech">7</WastepacksPerRecharge><!-- 充电时产出废料包（需要Biotech DLC）-->
    </statBases>

    <!-- 种族特性 -->
    <race>
      <body>DMS_LandCrab</body> <!-- 使用的身体类型 -->
      <nameGenerator>DMS_VanguardMechHeavy</nameGenerator> <!-- 名称生成器 -->
      <baseBodySize>4</baseBodySize> <!-- 基础体型 -->
      <baseHealthScale>5</baseHealthScale> <!-- 基础生命值比例 -->
      <mechWeightClass>UltraHeavy</mechWeightClass> <!-- 机甲重量类别：超重型 -->

      <!-- 残骸掉落物 -->
      <detritusLeavings>
        <li>
          <def>DMS_ChunkSlag</def> <!-- 掉落物定义 -->
          <texOverrideIndex>7</texOverrideIndex> <!-- 纹理索引 -->
          <spawnChance>0.4</spawnChance> <!-- 掉落概率 -->
        </li>
        <li>
          <def>DMS_ChunkSlag</def>
          <texOverrideIndex>4</texOverrideIndex>
          <spawnChance>0.4</spawnChance>
        </li>
      </detritusLeavings>
    </race>

    <!-- 组件定义 -->
    <comps>
      <!-- 体型近战加伤标记：攻击时若体型大于目标则追加钝器伤害 -->
      <li Class="DMS_Legion.CompProperties_BodySizeMeleeMarker" />
      <!-- 载具武器组件：无主武器时由框架配备 M777 -->
      <li Class="Fortified.CompProperties_VehicleWeapon">
        <defaultWeapon>DMSL_Gun_M777A</defaultWeapon>
        <drawData>
          <!-- 各个视角下的绘制数据 -->
          <dataEast>
            <offset>(-0.4,0,0.8)</offset> <!-- 向东视角偏移 -->
            <rotationOffset>-10</rotationOffset>
          </dataEast>
          <dataWest>
            <offset>(0.4,0,0.5)</offset> <!-- 向西视角偏移 -->
         <rotationOffset>10</rotationOffset>
          </dataWest>
          <dataSouth>
              <offset>(0.1,0,0.3)</offset> <!-- 向南视角偏移 -->
          </dataSouth>
          <dataNorth>
              <offset>(-0.1,0,0)</offset> <!-- 向北视角偏移 -->
          </dataNorth>
        </drawData>
        <turretRotationFollowPawn>true</turretRotationFollowPawn> <!-- 炮塔跟随pawn旋转 -->        
        <rotationSmoothTime>0.12</rotationSmoothTime> <!-- 旋转平滑时间 -->
      </li>  

      <!-- 多炮塔枪组件：整合所有副武器 -->
      <li Class="Fortified.CompPropertiesMultipleTurretGun">
        <subTurrets>
          <!-- 通用机枪子炮塔 -->
          <li>
            <ID>General-purpose machine gun</ID> <!-- ID标识 -->
            <turret>DMS_Gun_KordTurret</turret> <!-- 使用的炮塔 -->
            <autoAttack>true</autoAttack> <!-- 自动攻击 -->
            <warmingTime>5</warmingTime> <!-- 预热时间 -->
            <angleOffset>-90</angleOffset> <!-- 角度偏移 -->

            <!-- 渲染节点属性 -->
            <renderNodeProperties>
              <li>
                <nodeClass>Fortified.PawnRenderNode_SubTurretGun</nodeClass> <!-- 节点类 -->
                <workerClass>Fortified.PawnRenderNodeWorker_SubTurretGun</workerClass> <!-- 工人类 -->
                <parentTagDef>Body</parentTagDef> <!-- 父级标签定义 -->
                <drawSize>1.5</drawSize> <!-- 绘制尺寸 -->
                <baseLayer>-21</baseLayer> <!-- 基础层级 -->
                <pawnType>Any</pawnType> <!-- pawn类型 -->

                <!-- 各方向绘制数据 -->
                <drawData>
                  <dataEast>
                      <offset>(1.5,-1,0)</offset> <!-- 向东视角偏移 -->
                  </dataEast>
                  <dataWest>
                      <offset>(-1.5,-1,0)</offset> <!-- 向西视角偏移 -->
                      <rotationOffset>180</rotationOffset> <!-- 旋转偏移 -->
                  </dataWest>
                  <dataSouth>
                      <offset>(0.1,-1,-1.25)</offset> <!-- 向南视角偏移 -->
                  </dataSouth>
                  <dataNorth>
                      <offset>(-0.1,-1,1.25)</offset> <!-- 向北视角偏移 -->
                  </dataNorth>
                </drawData>
              </li>
            </renderNodeProperties>
          </li>
        </subTurrets>
      </li>
    </comps>

    <tools Inherit="False">
      <li>
        <label>Mechanical Head</label>                                           <!-- 机械头部 -->
        <capacities>
          <li>DMS_HeavySweep</li>                                                <!-- 重型扫荡攻击 -->
        </capacities>
        <power>35</power>                                                        <!-- 攻击力 -->
        <cooldownTime>5.5</cooldownTime>                                         <!-- 冷却时间 -->
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>              <!-- 关联身体部位组 -->
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.08</chanceFactor>                                        <!-- 攻击概率因子 -->
        <surpriseAttack>                                                         <!-- 偷袭攻击 -->
          <extraMeleeDamages>
            <li>
              <def>Stun</def>                                                    <!-- 致眩效果 -->
              <amount>20</amount>                                                <!-- 效果强度 -->
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>Left Leg</label>                                                  <!-- 左腿 -->
        <capacities>
          <li>DMS_HeavySweep</li>
        </capacities>
        <power>24</power>
        <cooldownTime>3.5</cooldownTime>
        <linkedBodyPartsGroup>LeftMechanicalLeg</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>16</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>Right Leg</label>                                                 <!-- 右腿 -->
        <capacities>
          <li>DMS_HeavySweep</li>
        </capacities>
        <power>24</power>
        <cooldownTime>3.5</cooldownTime>
        <linkedBodyPartsGroup>RightMechanicalLeg</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>16</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
    </tools>
    
    <!-- 伤害倍数调整 -->
    <damageMultipliers>                                                          
      <li>
        <damageDef>Blunt</damageDef>                                             <!-- 钝击伤害 -->
        <multiplier>0.5</multiplier>                                             <!-- 降低50%钝击伤害 -->
      </li>
      <li>
        <damageDef>Bomb</damageDef>                                              <!-- 爆炸伤害 -->
        <multiplier>0.5</multiplier>                                             <!-- 降低50%爆炸伤害 -->
      </li>
    </damageMultipliers>

    <!-- 分解产物 -->
    <butcherProducts>
      <Steel>200</Steel> <!-- 钢铁200个 -->
      <DMS_ChunkSlag>3</DMS_ChunkSlag> <!-- 渣块3个 -->
      <ComponentIndustrial>2</ComponentIndustrial> <!-- 工业部件2个 -->
    </butcherProducts>

    <!-- 阴影设置 -->
    <castEdgeShadows>false</castEdgeShadows> <!-- 不投射边缘阴影 -->
    <staticSunShadowHeight>0</staticSunShadowHeight> <!-- 静态太阳阴影高度为0 -->
  </ThingDef>

  <!-- 定义STGeorge机甲的种类 -->
  <PawnKindDef ParentName="BaseAutomatroidKind" Name="DMSL_Mech_STGeorge_Kind" Abstract="True">
    <defName>DMSL_Mech_STGeorge</defName> <!-- 内部标识符 -->
    <label>圣乔治</label> <!-- 显示名称 -->
    <race>DMSL_Mech_STGeorge</race> <!-- 使用的种族定义 -->
    <destroyGearOnDrop>true</destroyGearOnDrop> <!-- 倒地时销毁装备（武器），而非掉落 -->
    <isFighter>true</isFighter> <!-- 是战斗单位 -->
    <combatPower>500</combatPower> <!-- 战斗力：1000威胁点数 -->
    <maxPerGroup>2</maxPerGroup> <!-- 单个集群内最大数量：2 -->
    <isBoss>true</isBoss> <!-- 是Boss单位 -->

    <!-- 
    <techHediffsRequired>
      <li>DMS_CeramicsPlating</li>
    </techHediffsRequired>
    -->

    <!-- 生命阶段图形 -->
    <lifeStages>
      <!-- 第一阶段 -->
      <li>
        <bodyGraphicData>
          <texPath>Mechanoid/STGeorge/STGeorge</texPath> <!-- 纹理路径 -->
          <shaderType>CutoutComplex</shaderType> <!-- 着色器类型 -->
          <graphicClass>Graphic_Multi</graphicClass> <!-- 图形类 -->
          <drawSize>4.5</drawSize> <!-- 绘制大小 -->

          <!-- 阴影数据 -->
          <shadowData>
            <volume>(1.25,1,1.25)</volume> <!-- 体积 -->
            <offset>(0,0,-0.5)</offset> <!-- 偏移 -->
          </shadowData>
        </bodyGraphicData>
      </li>

      <!-- 第二阶段（旧纹理） -->
      <li>
        <bodyGraphicData>
          <texPath>Mechanoid/STGeorge/STGeorge</texPath> <!-- 纹理路径 -->
          <shaderType>CutoutComplex</shaderType> <!-- 着色器类型 -->
          <graphicClass>Graphic_Multi</graphicClass> <!-- 图形类 -->
          <drawSize>4.5</drawSize> <!-- 绘制大小 -->
          <shadowData>
            <volume>(1.25,1,1.25)</volume> <!-- 体积 -->
            <offset>(0,0,-0.5)</offset> <!-- 偏移 -->
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>

    <weaponMoney>9999~9999</weaponMoney>
    <weaponTags>
      <li>DMSL_STGeorge</li><!-- STGeorge专用武器标签 -->
    </weaponTags>
  </PawnKindDef>
  
  <!-- 实际使用的PawnKindDef -->
  <PawnKindDef ParentName="DMSL_Mech_STGeorge_Kind" Name="DMSL_Mech_STGeorge_Actual">
    <abilities>
      <li>DMSL_Ability_RapidReload</li>
    </abilities>
  </PawnKindDef>

</Defs>