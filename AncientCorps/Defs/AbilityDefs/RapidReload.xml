<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 应急维修能力 -->
  <AbilityDef>
    <defName>DMSL_Ability_RapidReload</defName><!-- 能力定义名称 -->
    <label>爆发装填</label><!-- 显示名称 -->
    <description>机械体进入爆发装填状态，射击冷却大幅缩短。</description><!-- 能力描述 -->
    <iconPath>UI/Abilities/RapidReload</iconPath><!-- 图标路径（需要创建对应图标） -->
    <cooldownTicksRange>120000~120000</cooldownTicksRange><!-- 冷却时间：2天（120000 ticks = 2 * 60000 ticks） -->
    <jobDef>CastAbilityOnThing</jobDef><!-- 工作定义：对物体施放能力 -->
    <targetRequired>False</targetRequired><!-- 不需要目标（对自己使用） -->
    <canUseAoeToGetTargets>False</canUseAoeToGetTargets><!-- 不使用AOE选择目标 -->
    <displayGizmoWhileUndrafted>True</displayGizmoWhileUndrafted><!-- 未征召时显示按钮 -->
    <disableGizmoWhileUndrafted>False</disableGizmoWhileUndrafted><!-- 未征召时不禁用按钮 -->
    <statBases><!-- 基础属性 -->
      <Ability_EffectRadius>0.9</Ability_EffectRadius><!-- 效果半径：0.9 -->
      <Ability_Duration>250</Ability_Duration><!-- 持续时间：250秒（5游戏小时 = 12500 ticks = 250秒） -->
    </statBases>
    <verbProperties><!-- 动词属性 -->
      <verbClass>Verb_CastAbility</verbClass><!-- 动词类：施放能力 -->
      <warmupTime>0.2</warmupTime><!-- 预热时间：0.2秒 -->
      <range>-1</range><!-- 施放范围：-1 -->
      <onlyManualCast>True</onlyManualCast><!-- 仅手动施放 -->
      <targetParams><!-- 目标参数 -->
        <canTargetSelf>True</canTargetSelf><!-- 可以对自己使用 -->
        <canTargetPawns>false</canTargetPawns><!-- 不能对单位使用 -->
        <canTargetBuildings>false</canTargetBuildings><!-- 不能对建筑使用 -->
        <canTargetAnimals>false</canTargetAnimals><!-- 不能对动物使用 -->
        <canTargetHumans>false</canTargetHumans><!-- 不能对人类使用 -->
        <canTargetMechs>false</canTargetMechs><!-- 不能对机械体使用 -->
      </targetParams>
    </verbProperties>
    <comps><!-- 组件列表 -->
      <li Class="CompProperties_AbilityGiveHediff"><!-- 给予Hediff的组件属性 -->
        <compClass>CompAbilityEffect_GiveHediff</compClass><!-- 组件类：给予Hediff效果 -->
        <hediffDef>DMSL_Hediff_RapidReload</hediffDef><!-- Hediff定义：快速装填 -->
        <onlyApplyToSelf>true</onlyApplyToSelf><!-- 仅对自己应用 -->
        <replaceExisting>true</replaceExisting><!-- 替换已存在的相同Hediff -->
      </li>
      <!-- 占位组件：后续可添加自定义组件 -->
      <!-- <li Class="DMS.CompProperties_EmergencyRepair">
        <compClass>DMS.CompAbilityEffect_EmergencyRepair</compClass>
      </li> -->
    </comps>
  </AbilityDef>
</Defs>
