<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Shaman 萨满（直接继承 BaseAutomatroidHumanRace，已合并原抽象父类） -->
  <ThingDef Name="DMSL_Mech_Shaman" ParentName="BaseAutomatroidHumanRace">
    <defName>DMSL_Mech_Shaman</defName>
    <label>萨满</label>
    <description>一种搭载了起灵装置的、拥有提供群体隐身能力的机械体。</description>
    <statBases>
      <MoveSpeed>4.7</MoveSpeed>
      <ArmorRating_Blunt>0.8</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.8</ArmorRating_Sharp>
      <ArmorRating_Heat>1.5</ArmorRating_Heat>
      <ShootingAccuracyPawn>1</ShootingAccuracyPawn>
      <AimingDelayFactor>1</AimingDelayFactor>
      <BandwidthCost MayRequire="Ludeon.Rimworld.Biotech">5</BandwidthCost>
      <WastepacksPerRecharge MayRequire="Ludeon.Rimworld.Biotech">4</WastepacksPerRecharge>
    </statBases>
    <comps>
      <!-- 万心失聪：冷却完成时 AI 立即自施法 -->
      <li Class="DMS_Legion.CompProperties_OmnimindSilenceAI" />
      <!-- 指挥中继组件 -->
      <li Class="Fortified.CompProperties_CommandRelay">
        <maxWorldMapRadius>10</maxWorldMapRadius>      <!-- 最大世界地图半径 -->
        <maxRelayRadius>20</maxRelayRadius>            <!-- 最大中继半径 -->
        <minRelayRadius>18</minRelayRadius>             <!-- 最小中继半径 -->
      </li>
    </comps>
    <race>
      <mechFixedSkillLevel>9</mechFixedSkillLevel>
      <body>DMS_Humanoid_TypeA</body>
      <baseBodySize>1.1</baseBodySize>
      <baseHealthScale>1.4</baseHealthScale>
      <mechWeightClass>Medium</mechWeightClass>
      <mechEnabledWorkTypes>
        <li>Hunting</li>
      </mechEnabledWorkTypes>
    </race>
    <butcherProducts>
      <DMS_ChunkSlag>1</DMS_ChunkSlag>
      <Tungsteel>30</Tungsteel>
    </butcherProducts>
    <modExtensions>
      <li Class="Fortified.MechWeaponExtension">
        <EnableWeaponFilter>true</EnableWeaponFilter><!-- 启用武器过滤器：是 -->
        <UsableWeaponTags><!-- 可使用的武器标签列表 -->
          <li>SimpleGun</li><!-- 简单枪械标签 -->
          <li>DMS_MechWeaponLight</li><!-- DMS轻型机械武器标签 -->
          <li>A_AR_LongRifle</li><!-- 突击步枪长步枪标签 -->
          <li>A_SAR_LongRifle</li><!-- 半自动步枪长步枪标签 -->
          <li>A_BR_LongRifle</li><!-- 战斗步枪长步枪标签 -->
          <li>A_MG_Light</li><!-- 轻型机枪标签 -->
          <li>ElephantGun</li><!-- 象枪标签 -->
          <li>SniperRifle</li><!-- 狙击步枪标签 -->
          <li>AssaultRifle</li>
        </UsableWeaponTags>
        <EnableTechLevelFilter>true</EnableTechLevelFilter><!-- 启用科技等级过滤器：是 -->
        <UsableTechLevels><!-- 可使用的科技等级列表 -->
          <li>Industrial</li><!-- 工业时代科技等级 -->
        </UsableTechLevels>
        <BypassUsableWeapons><!-- 绕过过滤器的可用武器列表 -->
          <!-- 如有需要可在此添加绕过的武器 -->
        </BypassUsableWeapons>
      </li>
    </modExtensions>
  </ThingDef>

  <PawnKindDef ParentName="BaseAutomatroidKind">
    <defName>DMSL_Mech_Shaman</defName><!-- 定义名称：DMS_Mech_Shaman -->
    <label>萨满</label><!-- 显示标签：Shaman -->
    <race>DMSL_Mech_Shaman</race><!-- 关联的种族：DMSL_Mech_Shaman -->
    <isFighter>true</isFighter><!-- 是否为战斗单位：是 -->
    <combatPower>250</combatPower><!-- 战斗力量：250 -->
    <maxPerGroup>12</maxPerGroup><!-- 每组最大数量：12 -->
    <lifeStages><!-- 生命阶段列表（用于定义不同阶段的贴图） -->
      <li><!-- 第一个生命阶段 -->
        <bodyGraphicData><!-- 身体图形数据 -->
          <texPath>Mechanoid/Shaman/Shaman</texPath><!-- 贴图路径：Mechanoid/Shaman/Shaman（相对于Textures目录） -->
          <shaderType>CutoutComplex</shaderType><!-- 着色器类型：复杂裁剪 -->
          <graphicClass>Graphic_Multi</graphicClass><!-- 图形类：多帧图形 -->
          <drawSize>1.5</drawSize><!-- 绘制大小：1.4 -->
          <shadowData><!-- 阴影数据 -->
            <volume>(0.35,1,0.35)</volume><!-- 阴影体积：(0.35,1,0.35) -->
            <offset>(0,0,0)</offset><!-- 阴影偏移：(0,0,0) -->
          </shadowData>
        </bodyGraphicData>
      </li>
      <li><!-- 第二个生命阶段（旧贴图） -->
        <bodyGraphicData><!-- 身体图形数据 -->
          <texPath>Mechanoid/Shaman/Shaman</texPath><!-- 贴图路径：Mechanoid/Shaman/Shaman（旧纹理） -->
          <shaderType>CutoutComplex</shaderType><!-- 着色器类型：复杂裁剪 -->
          <graphicClass>Graphic_Multi</graphicClass><!-- 图形类：多帧图形 -->
          <drawSize>1.5</drawSize><!-- 绘制大小：1.4 -->
          <shadowData><!-- 阴影数据 -->
            <volume>(0.35,1,0.35)</volume><!-- 阴影体积：(0.35,1,0.35) -->
            <offset>(0,0,0)</offset><!-- 阴影偏移：(0,0,0) -->
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
    <weaponTags><!-- 武器标签列表（生成时可能携带的武器类型） -->
      <li>A_MG_Light</li><!-- 轻型机枪标签 -->
      <li>A_DMR_LongRifle</li><!-- 精确射手步枪长步枪标签 -->
    </weaponTags>
    <abilities><!-- 特殊能力 -->
      <li>DMSL_Ability_OmnimindSilence</li>    
    </abilities>
  </PawnKindDef>

</Defs>