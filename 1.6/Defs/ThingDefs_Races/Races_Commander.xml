<?xml version="1.0" encoding="utf-8"?><!-- XML文件声明，指定版本1.0和UTF-8编码 -->
<Defs><!-- 定义根元素，包含所有游戏定义 -->

  <!-- Commander 指挥官（直接继承 BaseAutomatroidHumanRace，已合并原抽象父类） -->
  <ThingDef Name="DMSL_Mech_Commander" ParentName="BaseAutomatroidHumanRace">
    <defName>DMSL_Mech_Commander</defName>
    <label>指挥官</label>
    <description>用于承担军团内信息指挥链的指挥机机兵，用于带宽分流能力，可以协助机械师控制机械体。拥有带领远征队的能力。</description>
    <statBases>
      <MoveSpeed>4.6</MoveSpeed>
      <ArmorRating_Blunt>1.1</ArmorRating_Blunt>
      <ArmorRating_Sharp>1.1</ArmorRating_Sharp>
      <ArmorRating_Heat>1.5</ArmorRating_Heat>
      <ShootingAccuracyPawn>0</ShootingAccuracyPawn>
      <AimingDelayFactor>1</AimingDelayFactor>
      <BandwidthCost MayRequire="Ludeon.Rimworld.Biotech">4</BandwidthCost>
      <WastepacksPerRecharge MayRequire="Ludeon.Rimworld.Biotech">4</WastepacksPerRecharge>
    </statBases>
    <comps>
      <li Class="DMS_Legion.CompProperties_MechCommanderMarker">
        <extraMechBandwidth>16</extraMechBandwidth>
        <extraMechControlGroups>3</extraMechControlGroups>
      </li>
      <li Class="DMSL.CompProperties_CaravanOwner"/>
    </comps>
    <race>
      <mechFixedSkillLevel>8</mechFixedSkillLevel>
      <body>DMS_Humanoid_TypeB</body>
      <baseBodySize>1.2</baseBodySize>
      <baseHealthScale>1.5</baseHealthScale>
      <mechWeightClass>Medium</mechWeightClass>
      <mechEnabledWorkTypes>
        <li>Hunting</li>
        <li>Smithing</li>
      </mechEnabledWorkTypes>
    </race>
    <butcherProducts>
      <DMS_ChunkSlag>1</DMS_ChunkSlag>
      <Tungsteel>20</Tungsteel>
    </butcherProducts>
    <modExtensions>
      <li Class="Fortified.MechWeaponExtension"><!-- 机械武器扩展 -->
        <EnableWeaponFilter>true</EnableWeaponFilter><!-- 启用武器过滤器：是 -->
        <UsableWeaponTags><!-- 可使用的武器标签列表 -->
          <li>SimpleGun</li><!-- 简单枪械标签 -->
          <li>DMS_MechWeaponLight</li><!-- DMS轻型机械武器标签 -->
          <li>A_AR_LongRifle</li><!-- 突击步枪长步枪标签 -->
          <li>A_SAR_LongRifle</li><!-- 半自动步枪长步枪标签 -->
          <li>A_BR_LongRifle</li><!-- 战斗步枪长步枪标签 -->
          <li>A_MG_Light</li><!-- 轻型机枪标签 -->
          <li>ElephantGun</li><!-- 象枪标签 -->
          <li>SniperRifle</li><!-- 狙击步枪标签 -->
          <li>AssaultRifle</li>
        </UsableWeaponTags>
        <EnableTechLevelFilter>true</EnableTechLevelFilter><!-- 启用科技等级过滤器：是 -->
        <UsableTechLevels><!-- 可使用的科技等级列表 -->
          <li>Industrial</li><!-- 工业时代科技等级 -->
        </UsableTechLevels>
      </li>
      <li Class="Fortified.TurretMannableExtension"/><!-- 可操作炮塔扩展 -->
    </modExtensions>
  </ThingDef>

  <PawnKindDef ParentName="BaseAutomatroidKind"><!-- 定义机械体种类，继承自基础机械体种类 -->
    <defName>DMSL_Mech_Commander</defName><!-- 定义名称：DMS_Mech_Arquebusier -->
    <label>指挥官</label><!-- 显示标签：arquebusier -->
    <race>DMSL_Mech_Commander</race><!-- 关联的种族：DMSL_Mech_Commander -->
    <isFighter>true</isFighter><!-- 是否为战斗单位：是 -->
    <combatPower>150</combatPower><!-- 战斗力量：250 -->
    <maxPerGroup>12</maxPerGroup><!-- 每组最大数量：12 -->
    <lifeStages><!-- 生命阶段列表（用于定义不同阶段的贴图） -->
      <li><!-- 第一个生命阶段 -->
        <bodyGraphicData><!-- 身体图形数据 -->
          <texPath>Mechanoid/Commander/Commander</texPath><!-- 贴图路径：Mechanoid/Commander/Commander（相对于Textures目录） -->
          <shaderType>CutoutComplex</shaderType><!-- 着色器类型：复杂裁剪 -->
          <graphicClass>Graphic_Multi</graphicClass><!-- 图形类：多帧图形 -->
          <drawSize>1.5</drawSize><!-- 绘制大小：1.4 -->
          <shadowData><!-- 阴影数据 -->
            <volume>(0.35,1,0.35)</volume><!-- 阴影体积：(0.35,1,0.35) -->
            <offset>(0,0,0)</offset><!-- 阴影偏移：(0,0,0) -->
          </shadowData>
        </bodyGraphicData>
      </li>
      <li><!-- 第二个生命阶段（旧贴图） -->
        <bodyGraphicData><!-- 身体图形数据 -->
          <texPath>Mechanoid/Commander/Commander</texPath><!-- 贴图路径：Things/Automatroid/OldTexture/arquebusier（旧纹理） -->
          <shaderType>CutoutComplex</shaderType><!-- 着色器类型：复杂裁剪 -->
          <graphicClass>Graphic_Multi</graphicClass><!-- 图形类：多帧图形 -->
          <drawSize>1.5</drawSize><!-- 绘制大小：1.4 -->
          <shadowData><!-- 阴影数据 -->
            <volume>(0.35,1,0.35)</volume><!-- 阴影体积：(0.35,1,0.35) -->
            <offset>(0,0,0)</offset><!-- 阴影偏移：(0,0,0) -->
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
    <weaponTags><!-- 武器标签列表（生成时可能携带的武器类型） -->
          <li>SimpleGun</li><!-- 简单枪械标签 -->
          <li>DMS_MechWeaponLight</li><!-- DMS轻型机械武器标签 -->
          <li>A_AR_LongRifle</li><!-- 突击步枪长步枪标签 -->
          <li>A_SAR_LongRifle</li><!-- 半自动步枪长步枪标签 -->
          <li>A_BR_LongRifle</li><!-- 战斗步枪长步枪标签 -->
          <li>A_MG_Light</li><!-- 轻型机枪标签 -->
          <li>ElephantGun</li><!-- 象枪标签 -->
          <li>SniperRifle</li><!-- 狙击步枪标签 -->
          <li>AssaultRifle</li>
    </weaponTags>
    <abilities>
      <li>DMSL_Ability_RepairDesignate</li>
    </abilities>
  </PawnKindDef>

</Defs><!-- 定义根元素结束 -->
