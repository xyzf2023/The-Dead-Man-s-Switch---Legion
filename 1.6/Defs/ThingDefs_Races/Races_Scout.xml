<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- scout 侦察兵/机械骑兵（直接继承 BaseAutomatroidHumanRace，已合并原抽象父类） -->
  <ThingDef Name="DMSL_Mech_scout" ParentName="BaseAutomatroidHumanRace">
    <defName>DMSL_Mech_Scout</defName>
    <label>斥候</label>
    <description>一种配备了机械马的先锋，由人工肌肉提供无与伦比的速度使得它在侦查方面有不可替代的优势。</description>
    <statBases>
      <MoveSpeed>4.5</MoveSpeed>
      <ArmorRating_Blunt>0.8</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.8</ArmorRating_Sharp>
      <ArmorRating_Heat>1.3</ArmorRating_Heat>
      <ShootingAccuracyPawn>3</ShootingAccuracyPawn>
      <AimingDelayFactor>0.9</AimingDelayFactor>
      <BandwidthCost MayRequire="Ludeon.Rimworld.Biotech">2</BandwidthCost>
      <WastepacksPerRecharge MayRequire="Ludeon.Rimworld.Biotech">4</WastepacksPerRecharge>
    </statBases>
    <race>
      <mechFixedSkillLevel>8</mechFixedSkillLevel>
      <body>DMSL_MechanicsCavalryman_TypeA</body>
      <baseBodySize>2</baseBodySize>
      <baseHealthScale>2</baseHealthScale>
      <mechWeightClass>Medium</mechWeightClass>
      <mechEnabledWorkTypes>
        <li>Hunting</li>
        <li>Hauling</li>
      </mechEnabledWorkTypes>
    </race>
    <butcherProducts>
      <DMS_ChunkSlag>1</DMS_ChunkSlag>
      <Tungsteel>50</Tungsteel>
    </butcherProducts>
    <comps>
      <li Class="DMS_Legion.CompProperties_MoveSpeedMomentum">
        <cellsToMaxSpeed>25</cellsToMaxSpeed>
        <maxSpeedFactor>5</maxSpeedFactor>
        <ticksToResetMomentum>120</ticksToResetMomentum>
      </li>
    </comps>
    <modExtensions>
      <li Class="Fortified.MechWeaponExtension">
        <!-- 启用武器过滤器 -->
        <EnableWeaponFilter>true</EnableWeaponFilter>
        <!-- 可使用武器标签列表 -->
        <UsableWeaponTags>
          <li>SimpleGun</li><!-- 简单枪械标签 -->
          <li>DMS_MechWeaponLight</li><!-- DMS轻型机械武器标签 -->
          <li>A_AR_LongRifle</li><!-- 突击步枪长步枪标签 -->
          <li>A_SAR_LongRifle</li><!-- 半自动步枪长步枪标签 -->
          <li>A_BR_LongRifle</li><!-- 战斗步枪长步枪标签 -->
          <li>A_MG_Light</li><!-- 轻型机枪标签 -->
          <li>ElephantGun</li><!-- 象枪标签 -->
          <li>SniperRifle</li><!-- 狙击步枪标签 -->
          <li>AssaultRifle</li>
          <li>DMSL_Lance</li>
        </UsableWeaponTags>
        <!-- 启用科技等级过滤器 -->
        <EnableTechLevelFilter>true</EnableTechLevelFilter>
        <!-- 可使用工业及以上级别的武器 -->
        <UsableTechLevels>
          <li>Industrial</li>
          <li>Spacer</li>
        </UsableTechLevels>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- scout角色定义 -->
  <PawnKindDef ParentName="BaseAutomatroidKind">
    <defName>DMSL_Mech_Scout</defName>
    <label>斥候</label>
    <!-- 关联到具体的机械单位类型 -->
    <race>DMSL_Mech_Scout</race>
    <!-- 是战斗单位 -->
    <isFighter>true</isFighter>
    <!-- 战斗力为300 -->
    <combatPower>300</combatPower>
    <!-- 每组最多12个单位 -->
    <maxPerGroup>12</maxPerGroup>
    
    <!-- 生命周期阶段图像数据 -->
    <lifeStages>
      <li>
        <bodyGraphicData>
          <!-- 使用scout纹理路径 -->
          <texPath>Mechanoid/scout/scout</texPath>
          <!-- 复杂镂空着色器，支持透明效果 -->
          <shaderType>CutoutComplex</shaderType>
          <!-- 多方向图形类 -->
          <graphicClass>Graphic_Multi</graphicClass>
          <!-- 绘制大小为2倍 -->
          <drawSize>2</drawSize>
          <!-- 阴影体积和偏移 -->
          <shadowData>
            <volume>(0.35,1,0.35)</volume>
            <offset>(0,0,0)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
      <li>
        <!-- 第二阶段与第一阶段相同 -->
        <bodyGraphicData>
          <texPath>Mechanoid/scout/scout</texPath>
          <shaderType>CutoutComplex</shaderType>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>2</drawSize>
          <shadowData>
            <volume>(0.35,1,0.35)</volume>
            <offset>(0,0,0)</offset>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
    
    <!-- 可携带武器标签 -->
    <weaponTags>
      <li>DMSL_Lance</li>
    </weaponTags>

    <!-- 技能/能力 -->
    <abilities>
      <li>DMS_BurstSprint</li>
    </abilities>
  </PawnKindDef>

</Defs>