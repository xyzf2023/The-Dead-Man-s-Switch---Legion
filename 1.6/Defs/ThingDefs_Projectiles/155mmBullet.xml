<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 主炮的投射物定义：155mm高爆炮弹 -->
  <ThingDef ParentName="BaseBullet">
    <!-- 定义唯一标识符 -->
    <defName>DMSL_Bullet_PZH2000Shell</defName>
    
    <!-- 显示名称 -->
    <label>155mm high-explosive shell</label>
    
    <!-- 实体类别：爆炸性投射物 -->
    <thingClass>Projectile_Explosive</thingClass>
    
    <!-- 图像数据 -->
    <graphicData>
      <!-- 纹理路径：使用大型子弹纹理 -->
      <texPath>Things/Projectile/Bullet_Big</texPath>
      
      <!-- 图形类别：单个图像 -->
      <graphicClass>Graphic_Single</graphicClass>
      
      <!-- 绘制尺寸：放大2倍 -->
      <drawSize>2</drawSize>
    </graphicData>
    
    <!-- 投射物属性 -->
    <projectile>
      <!-- 伤害类型：炸弹爆炸伤害 -->
      <damageDef>Bomb</damageDef>
      
      <!-- 基础伤害数值：360点 -->
      <damageAmountBase>100</damageAmountBase>
      
      <!-- 护甲穿透值：0.77 -->
      <armorPenetrationBase>0.77</armorPenetrationBase>
      
      <!-- 移动速度：100单位/秒 -->
      <speed>100</speed>
      
      <!-- 爆炸半径：15.9格 -->
      <explosionRadius>8.9</explosionRadius>
      
      <!-- 是否飞越头顶：是（适用于曲射火炮） -->
      <flyOverhead>true</flyOverhead>
      
      <!-- 声音效果 -->
      <!-- 击中厚屋顶的声音 -->
      <soundHitThickRoof>Artillery_HitThickRoof</soundHitThickRoof>
      <!-- 爆炸声音 -->
      <soundExplode>Explosion_GiantBomb</soundExplode>
      <!-- 撞击预兆声音 -->
      <soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
      <!-- 环境声音（飞行中） -->
      <soundAmbient>MortarRound_Ambient</soundAmbient>
    </projectile>
    
    <!-- 组件定义 -->
    <comps>
      <!-- 眩晕爆炸组件 -->
      <li Class="CompProperties_Explosive">
        <explosiveRadius>15.9</explosiveRadius> <!-- 眩晕爆炸半径 -->
        <explosiveDamageType>Stun</explosiveDamageType> <!-- 眩晕伤害类型 -->
        <armorPenetrationBase>0.2</armorPenetrationBase> <!-- 眩晕攻击的护甲穿透 -->
        <damageAmountBase>20</damageAmountBase> <!-- 眩晕伤害量 -->
        <explodeOnDestroyed>true</explodeOnDestroyed> <!-- 被摧毁时爆炸 -->
        <explodeOnKilled>true</explodeOnKilled> <!-- 被击杀时爆炸 -->
        <doSoundEffects>false</doSoundEffects> <!-- 无额外声音效果 -->
        <doVisualEffects>false</doVisualEffects> <!-- 无额外视觉效果 -->
        <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors> <!-- 对邻近格子造成伤害 -->
      </li>
    </comps>
  </ThingDef>
</Defs>