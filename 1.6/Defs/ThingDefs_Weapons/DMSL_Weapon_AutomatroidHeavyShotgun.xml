<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- ================================================ -->
    <!-- 子弹定义部分 - Automatroid重型机枪子弹 -->
    <!-- ================================================ -->
    <ThingDef ParentName="BaseBullet">
        <!-- 子弹的唯一标识符 -->
        <defName>DMSL_Bullet_AutomatroidHeavyShotgun</defName>
        <!-- 游戏中显示的子弹名称 -->
        <label>机兵重型霰弹枪子弹</label>
        
        <!-- 子弹视觉效果配置 -->
        <graphicData>
            <!-- 子弹纹理路径 -->
            <texPath>Things/Projectile/Bullet_Shotgun</texPath>
            <!-- 图形渲染类 -->
            <graphicClass>Graphic_Single</graphicClass>
            <!-- 着色器类型，支持透明和光照效果 -->
            <shaderType>TransparentPostLight</shaderType>
            <!-- 子弹绘制尺寸：标准大小 -->
            <drawSize>2</drawSize>
        </graphicData>
        
        <!-- 子弹弹道和伤害属性 -->
        <projectile>
            <!-- 伤害类型：标准子弹伤害 -->
            <damageDef>Bullet</damageDef>
            <!-- 基础伤害值：21点 -->
            <damageAmountBase>21</damageAmountBase>
            <!-- 飞行速度：60格/秒 -->
            <speed>60</speed>
            <!-- 制止力：影响击退效果 -->
            <stoppingPower>6</stoppingPower>
            <!-- 护甲穿透率：34% -->
            <armorPenetrationBase>0.34</armorPenetrationBase>
        </projectile>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <!-- 子弹的唯一标识符 -->
        <defName>DMSL_Bullet_2AutomatroidHeavyShotgun</defName>
        <!-- 游戏中显示的子弹名称 -->
        <label>机兵重型霰弹枪子弹2</label>
        
        <!-- 子弹视觉效果配置 -->
        <graphicData>
            <!-- 子弹纹理路径 -->
            <texPath>Things/Projectile/Bullet_Small</texPath>
            <!-- 图形渲染类 -->
            <graphicClass>Graphic_Single</graphicClass>
            <!-- 着色器类型，支持透明和光照效果 -->
            <shaderType>TransparentPostLight</shaderType>
            <!-- 子弹绘制尺寸：标准大小 -->
            <drawSize>4</drawSize>
        </graphicData>
        
        <!-- 子弹弹道和伤害属性 -->
        <projectile>
  	    	<explosionRadius>1.9</explosionRadius>
            <!-- 伤害类型：爆炸伤害 -->
            <damageDef>Stun</damageDef>
            <!-- 基础伤害值：15点 -->
            <damageAmountBase>15</damageAmountBase>
            <!-- 飞行速度：60格/秒 -->
            <speed>60</speed>
            <!-- 护甲穿透率：10% -->
            <armorPenetrationBase>0.1</armorPenetrationBase>
        </projectile>
    </ThingDef>

    <!-- ================================================ -->
    <!-- 武器定义部分 - 机兵重机枪 -->
    <!-- ================================================ -->
    <ThingDef ParentName="DMS_AutomatroidGun">
        <!-- 武器唯一标识符 -->
        <defName>DMSL_Weapon_AutomatroidHeavyShotgun</defName>
        <!-- 武器显示名称 -->
        <label>机兵重型霰弹枪</label>
        <!-- 武器详细描述 -->
        <description>只能由机械体或者装备外骨骼的战斗人员所装备的大口径霰弹枪，可以发射震撼弹。</description>
        
        <!-- 武器视觉表现配置 -->
        <graphicData>
            <!-- 武器纹理文件路径 -->
            <texPath>Weapons/DMSL_Weapon_AutomatroidHeavyShotgun/DMSL_Weapon_AutomatroidHeavyShotgun</texPath>
            <!-- 图形渲染类 -->
            <graphicClass>Graphic_Single</graphicClass>
            <!-- 武器绘制尺寸：1.2倍标准大小 -->
            <drawSize>1.2</drawSize>
        </graphicData>

        <!-- 武器分类：DMS 霰弹枪使用 ShortShots + RangedHeavy + Ranged -->
        <weaponClasses>
            <li>ShortShots</li>
            <li>RangedHeavy</li>
            <li>Ranged</li>
        </weaponClasses>
      
        <!-- 制造配方配置 -->
        <recipeMaker>
            <!-- 制造前提研究项目 -->
            <researchPrerequisites>
                <li>GasOperation</li>        <!-- 气体操作技术 -->
                <li>DMS_EquipmentElite</li>  <!-- 精英装备技术 -->
            </researchPrerequisites>
            <!-- 制造技能要求 -->
            <skillRequirements>
                <Crafting>6</Crafting>       <!-- 需要6级制造技能 -->
            </skillRequirements>
            <!-- 制造菜单显示优先级 -->
            <displayPriority>440</displayPriority>
        </recipeMaker>
        
        <!-- 武器基础属性 -->
        <statBases>
            <WorkToMake>40000</WorkToMake>      <!-- 制造工作量：40000 ticks -->
            <Mass>3.5</Mass>                    <!-- 重量：3.5kg -->
            <AccuracyTouch>0.8</AccuracyTouch>  <!-- 近距离命中率：80% -->
            <AccuracyShort>0.9</AccuracyShort>  <!-- 短距离命中率：90% -->
            <AccuracyMedium>0.7</AccuracyMedium><!-- 中距离命中率：70% -->
            <AccuracyLong>0.5</AccuracyLong>    <!-- 长距离命中率：50% -->
            <RangedWeapon_Cooldown>1.65</RangedWeapon_Cooldown>  <!-- 射击冷却：1.65秒 -->
            <MarketValue>1200</MarketValue>     <!-- 市场价值：1200银 -->
            <!-- <DMS_HeavyGears>1.1</DMS_HeavyGears> -->
            <!-- 体型要求：1.1级（标准自动化单位） -->
        </statBases>
        
        <!-- 制造材料成本 -->
        <costList>
            <Tungsteel>65</Tungsteel>          <!-- 钨钢：65单位 -->
            <ComponentStamped>4</ComponentStamped> <!-- 冲压组件：4个 -->
        </costList>
        
        <!-- 武器攻击行为定义 -->
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>           <!-- 射击动作类 -->
                <hasStandardCommand>true</hasStandardCommand> <!-- 启用标准命令 -->
                <defaultProjectile>DMSL_Bullet_AutomatroidHeavyShotgun</defaultProjectile> <!-- 使用的子弹类型 -->
                <warmupTime>1</warmupTime>               <!-- 射击准备时间：1秒 -->
                <range>21</range>                        <!-- 射程：28格 -->
                <burstShotCount>2</burstShotCount>        <!-- 连发子弹数：2发 -->
                <ticksBetweenBurstShots>9</ticksBetweenBurstShots> <!-- 连发间隔：9 ticks -->
                <soundCast>Shot_HeavySMG</soundCast>       <!-- 射击音效 -->
                <soundCastTail>GunTail_Heavy</soundCastTail> <!-- 射击尾音 -->
                <muzzleFlashScale>6</muzzleFlashScale>     <!-- 枪口火焰大小 -->
            </li>
        </verbs>
        
        <!-- 武器组件设置，Inherit="False"表示不继承父级组件 -->
        <comps Inherit="False">
            <li>
                <compClass>CompEquippable</compClass>
            </li>
            <!-- 双模式武器组件，支持切换主副攻击模式（通过Gizmo按钮切换） -->
            <li Class="DMS_Legion.CompProperties_SecondaryVerb_Rework">
                <!-- 主武器模式标签 -->
                <mainWeaponLabel>霰弹</mainWeaponLabel>
                <!-- 主模式命令图标 -->
                <mainCommandIcon>UI/Abilities/WeaponModeSwitch</mainCommandIcon>
                <!-- 副武器模式标签 -->
                <secondaryWeaponLabel>闪光弹</secondaryWeaponLabel>
                <!-- 副模式命令图标 -->
                <secondaryCommandIcon>UI/Abilities/WeaponModeSwitch</secondaryCommandIcon>
                <!-- 组件描述 -->
                <description>切换模式</description>
                <!-- 副攻击模式参数（狙击步枪模式） -->
                <verbProps>
                    <!-- 使用射击动作类 -->
                    <verbClass>Verb_Shoot</verbClass>
                    <!-- 是否使用标准指令 -->
                    <hasStandardCommand>true</hasStandardCommand>
                    <!-- 使用狙击步枪弹药 -->
                    <defaultProjectile>DMSL_Bullet_2AutomatroidHeavyShotgun</defaultProjectile>
                    <!-- 较长的准备时间，适合精确射击 -->
                    <warmupTime>1</warmupTime>
                    <!-- 更远的射击距离 -->
                    <range>16</range>
                    <!-- 狙击步枪射击音效 -->
                    <soundCast>Shot_SniperRifle</soundCast>
                    <!-- 射击尾音 -->
                    <soundCastTail>GunTail_Heavy</soundCastTail>
                    <!-- 枪口火焰大小 -->
                    <muzzleFlashScale>9</muzzleFlashScale>
                </verbProps>
            </li>
            <!-- 可禁止组件，允许标记为禁止使用 -->
            <li Class="CompProperties_Forbiddable"/>
            <!-- 可样式化组件，允许应用样式 -->
            <li Class="CompProperties_Styleable"/>
        </comps>  <!-- 添加缺失的闭合标签 -->

        <!-- 武器标签：DMS 机兵重型霰弹枪 -->
        <weaponTags>
            <li>DMS_MechWeaponMedium</li>     <!-- DMS 中型机兵武器 -->
            <li>DMS_MechWeaponShotgun</li>    <!-- DMS 霰弹枪 -->
            <li>A_RC</li>                     <!-- 失能机关 RC 标签 -->
        </weaponTags>

        <!-- 重型装备扩展配置 -->
        <modExtensions>
            <li Class="Fortified.HeavyEquippableExtension">
                <!-- 指定只有标准自动化单位可以装备 -->
                <EquippableDef>StandardAutomatroid</EquippableDef>
            </li>
        </modExtensions>
        
        <!-- 近战攻击配置 -->
        <tools>
            <!-- 握把攻击 -->
            <li>
                <label>grip</label>              <!-- 攻击部位：握把 -->
                <capacities>
                    <li>Blunt</li>               <!-- 攻击类型：钝击 -->
                </capacities>
                <power>9</power>                 <!-- 攻击威力：9点 -->
                <cooldownTime>2</cooldownTime>   <!-- 冷却时间：2秒 -->
            </li>
            <!-- 枪管戳击 -->
            <li>
                <label>barrel</label>            <!-- 攻击部位：枪管 -->
                <capacities>
                    <li>Blunt</li>               <!-- 攻击类型：钝击 -->
                    <li>Poke</li>                <!-- 攻击类型：戳刺 -->
                </capacities>
                <power>9</power>                 <!-- 攻击威力：9点 -->
                <cooldownTime>2</cooldownTime>   <!-- 冷却时间：2秒 -->
            </li>
        </tools>
    </ThingDef>
</Defs>