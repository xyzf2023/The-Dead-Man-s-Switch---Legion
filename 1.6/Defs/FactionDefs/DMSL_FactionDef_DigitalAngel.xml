<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    电子天使：隐藏派系，不参与据点生成，仅通过事件/脚本参与剧情。
    参考：异象邪教徒/奥德赛太空海盗（hidden + 无据点）+ 机械族巢穴（非人形、敌对等）。
  -->
  <FactionDef ParentName="FactionBase">
    <defName>DMSL_Faction_DigitalAngel</defName>
    <label>电子天使</label>
    <description>一个神秘的、不属于武装殖民舰队管辖的机兵集团，似乎与某个存在有着千丝万缕的关系。</description>

    <!-- 隐藏派系：不显示在派系列表，且不参与据点生成 -->
    <hidden>true</hidden>
    <displayInFactionSelection>false</displayInFactionSelection>
    <!-- 不设 settlementGenerationWeight / settlementNameMaker，配合 hidden 实现无据点 -->

    <!-- 机兵派系：非人形，参考机械族 -->
    <humanlikeFaction>false</humanlikeFaction>
    <hostileToFactionlessHumanlikes>true</hostileToFactionlessHumanlikes>
    <permanentEnemy>true</permanentEnemy>

    <!-- 世界生成与配置 -->
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>900</configurationListOrderPriority>

    <!-- 外观与标识（隐藏派系可用固定名，无需 factionNameMaker） -->
    <fixedName>电子天使</fixedName>
    <factionIconPath>UI/Faction/DigitalAngel</factionIconPath>
    <colorSpectrum>
      <li>(0.4, 0.6, 0.9)</li>
    </colorSpectrum>

    <!-- 战斗与到达：禁止被选为袭击来源，仅由剧情/事件脚本生成 -->
    <raidsForbidden>true</raidsForbidden>
    <autoFlee>false</autoFlee>
    <canStageAttacks>true</canStageAttacks>
    <canUseAvoidGrid>false</canUseAvoidGrid>
    <allowedArrivalTemperatureRange>-100~200</allowedArrivalTemperatureRange>
    <earliestRaidDays>45</earliestRaidDays>
    <messageDefendersAttacking>{0} from {1} are attacking your {2}.</messageDefendersAttacking>

    <!-- 点数与战利品曲线（参考机械族） -->
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(400,200)</li>
        <li>(900,300)</li>
        <li>(100000,10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
    <raidCommonalityFromPointsCurve>
      <points>
        <li>(300,  0)</li>
        <li>(700,  1)</li>
        <li>(1400, 1.8)</li>
        <li>(2800, 2.2)</li>
        <li>(4000, 2.6)</li>
      </points>
    </raidCommonalityFromPointsCurve>
    <raidLootMaker>MechanoidRaidLootMaker</raidLootMaker>
    <raidLootValueFromPointsCurve>
      <points>
        <li>(35,     15)</li>
        <li>(100,   120)</li>
        <li>(1000,  500)</li>
        <li>(2000,  800)</li>
        <li>(4000, 1000)</li>
      </points>
    </raidLootValueFromPointsCurve>

    <!-- 称呼与科技等级 -->
    <pawnSingular>机兵</pawnSingular>
    <pawnsPlural>机兵</pawnsPlural>
    <techLevel>Ultra</techLevel>

    <!-- 出战组合：占位用本 mod 机兵，可后续替换为专属兵种 -->
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>100</commonality>
        <options>
          <DMSL_Mech_Engineer>10</DMSL_Mech_Engineer>
        </options>
      </li>
    </pawnGroupMakers>
  </FactionDef>
</Defs>
