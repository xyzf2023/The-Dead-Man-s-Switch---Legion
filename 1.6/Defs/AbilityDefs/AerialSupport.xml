<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 空中支援能力 -->
  <AbilityDef>
    <defName>DMSL_Ability_AerialSupport</defName><!-- 能力定义名称 -->
    <label>空中支援</label><!-- 显示名称 -->
    <description>这是一个用于测试的技能。你可以用它召唤所有类型的空中支援。</description><!-- 能力描述 -->
    <iconPath>UI/Abilities/AerialSupport</iconPath><!-- 图标路径（需要创建对应图标） -->
    <cooldownTicksRange>0~0</cooldownTicksRange><!-- 冷却时间：无冷却 -->
    <targetRequired>false</targetRequired><!-- 不需要目标，参照战术指令 -->
    <showWhenDrafted>true</showWhenDrafted><!-- 征召时显示 -->
    <displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted><!-- 未征召时显示按钮 -->
    <disableGizmoWhileUndrafted>false</disableGizmoWhileUndrafted><!-- 未征召时不禁用按钮 -->
    <verbProperties><!-- 动词属性 -->
      <verbClass>Verb_CastAbility</verbClass><!-- 动词类：施放能力 -->
      <range>-1</range><!-- 范围：-1，无距离限制 -->
      <warmupTime>0</warmupTime><!-- 预热时间：0秒 -->
      <nonInterruptingSelfCast>true</nonInterruptingSelfCast><!-- 非中断性自我施放 -->
      <targetParams><!-- 目标参数 -->
        <canTargetLocations>false</canTargetLocations><!-- 不能选择位置 -->
        <canTargetPawns>false</canTargetPawns><!-- 不能对单位使用 -->
        <canTargetBuildings>false</canTargetBuildings><!-- 不能对建筑使用 -->
        <canTargetItems>false</canTargetItems><!-- 不能对物品使用 -->
      </targetParams>
    </verbProperties>
    <comps><!-- 组件列表 -->
      <!-- 空中支援组件 - 处理菜单、目标选择和执行 -->
      <li Class="DMS_Legion.CompProperties_AerialSupport">
      </li>
    </comps>
  </AbilityDef>
</Defs>
