<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 萨满：中型复活列表，参照 DMS 中型组装配方结构 -->
  <RecipeDef ParentName="DMS_MediumMechanoidRecipe">
    <defName>DMSL_Make_Shaman</defName>
    <label>组装萨满</label>
    <description>组装一个萨满。</description>
    <products>
      <DMSL_Mech_Shaman>1</DMSL_Mech_Shaman>
    </products>
    <researchPrerequisite>DMS_Hypothesis</researchPrerequisite>
    <gestationCycles>1</gestationCycles>
    <descriptionHyperlinks>
      <ThingDef>DMSL_Mech_Shaman</ThingDef>
    </descriptionHyperlinks>
    <ingredients Inherit="False">
      <li>
        <filter>
          <thingDefs>
            <li>Tungsteel</li>
          </thingDefs>
        </filter>
        <count>80</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
      <!-- 皇权DLC：启灵装置（psylink neuroformer） -->
      <li MayRequire="Ludeon.RimWorld.Royalty">
        <filter>
          <thingDefs>
            <li>PsychicAmplifier</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Synthread</li>
            <li>Polyester</li>
          </thingDefs>
        </filter>
        <count>25</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentStamped</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Neurocomputer</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentTransmitter</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Tungsteel</li>
        <li>Steel</li>
        <li>Synthread</li>
        <li>Polyester</li>
        <li>ComponentIndustrial</li>
        <li>ComponentSpacer</li>
        <li>ComponentStamped</li>
        <li MayRequire="Ludeon.RimWorld.Royalty">PsychicAmplifier</li>
        <li>Neurocomputer</li>
        <li>ComponentTransmitter</li>
      </thingDefs>
    </fixedIngredientFilter>
  </RecipeDef>
</Defs>
