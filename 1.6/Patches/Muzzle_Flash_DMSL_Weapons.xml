<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- 仅在加载 Muzzle Flash 时应用：为本模组远程枪械追加 MuzzleFlashProps -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Muzzle Flash</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- DMSL_Weapon_AutomatroidAssaultRifle（机兵突击步枪（下挂榴弹）） -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="DMSL_Weapon_AutomatroidAssaultRifle"]/modExtensions</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="DMSL_Weapon_AutomatroidAssaultRifle"]/modExtensions</xpath>
            <value>
              <!-- 主模式（默认 verbs[0]） -->
              <li Class="MuzzleFlash.MuzzleFlashProps">
                <type>Primary</type>
                <def>MF_StandardMuzzleFalshThree</def>
                <drawSize>(1,1)</drawSize>
                <offsets>
                  <li>(0.80,0.02)</li>
                </offsets>
              </li>
              <!-- 次模式（CompSecondaryVerb_Rework 切换后的 verbProps） -->
              <li Class="MuzzleFlash.MuzzleFlashProps">
                <type>Secondary</type>
                <def>MF_StandardMuzzleFalsh</def>
                <drawSize>(1.4,1.4)</drawSize>
                <offsets>
                  <li>(0.80,0.02)</li>
                </offsets>
              </li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="DMSL_Weapon_AutomatroidAssaultRifle"]</xpath>
            <value>
              <modExtensions>
                <li Class="MuzzleFlash.MuzzleFlashProps">
                  <type>Primary</type>
                  <def>MF_StandardMuzzleFalshThree</def>
                  <drawSize>(1,1)</drawSize>
                  <offsets>
                    <li>(0.80,0.02)</li>
                  </offsets>
                </li>
                <li Class="MuzzleFlash.MuzzleFlashProps">
                  <type>Secondary</type>
                  <def>MF_StandardMuzzleFalsh</def>
                  <drawSize>(1.4,1.4)</drawSize>
                  <offsets>
                    <li>(0.80,0.02)</li>
                  </offsets>
                </li>
              </modExtensions>
            </value>
          </nomatch>
        </li>

        <!-- DMSL_Weapon_AutomatroidHeavyMachineGun（机兵链锯/重机枪） -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="DMSL_Weapon_AutomatroidHeavyMachineGun"]/modExtensions</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="DMSL_Weapon_AutomatroidHeavyMachineGun"]/modExtensions</xpath>
            <value>
              <li Class="MuzzleFlash.MuzzleFlashProps">
                <type>All</type>
                <def>MF_StandardMuzzleFalsh</def>
                <drawSize>(1.3,1.3)</drawSize>
                <offsets>
                  <li>(1.15,0.00)</li>
                </offsets>
              </li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="DMSL_Weapon_AutomatroidHeavyMachineGun"]</xpath>
            <value>
              <modExtensions>
                <li Class="MuzzleFlash.MuzzleFlashProps">
                  <type>All</type>
                  <def>MF_StandardMuzzleFalsh</def>
                  <drawSize>(1.3,1.3)</drawSize>
                  <offsets>
                    <li>(1.15,0.00)</li>
                  </offsets>
                </li>
              </modExtensions>
            </value>
          </nomatch>
        </li>

        <!-- DMSL_Weapon_AutomatroidHeavyShotgun（机兵重型霰弹枪） -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="DMSL_Weapon_AutomatroidHeavyShotgun"]/modExtensions</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="DMSL_Weapon_AutomatroidHeavyShotgun"]/modExtensions</xpath>
            <value>
              <li Class="MuzzleFlash.MuzzleFlashProps">
                <type>All</type>
                <def>MF_StandardMuzzleFalsh</def>
                <drawSize>(1.0,1.4)</drawSize>
                <offsets>
                  <li>(0.72,0.04)</li>
                </offsets>
              </li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="DMSL_Weapon_AutomatroidHeavyShotgun"]</xpath>
            <value>
              <modExtensions>
                <li Class="MuzzleFlash.MuzzleFlashProps">
                  <type>All</type>
                  <def>MF_StandardMuzzleFalsh</def>
                  <drawSize>(1.0,1.4)</drawSize>
                  <offsets>
                    <li>(0.72,0.04)</li>
                  </offsets>
                </li>
              </modExtensions>
            </value>
          </nomatch>
        </li>

        <!-- DMSL_Weapon_CompetitiveRifle（竞技步枪） -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="DMSL_Weapon_CompetitiveRifle"]/modExtensions</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="DMSL_Weapon_CompetitiveRifle"]/modExtensions</xpath>
            <value>
              <li Class="MuzzleFlash.MuzzleFlashProps">
                <type>All</type>
                <def>MF_StandardMuzzleFalshThree</def>
                <drawSize>(1.1,1.1)</drawSize>
                <offsets>
                  <li>(0.85,0.00)</li>
                </offsets>
              </li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="DMSL_Weapon_CompetitiveRifle"]</xpath>
            <value>
              <modExtensions>
                <li Class="MuzzleFlash.MuzzleFlashProps">
                  <type>All</type>
                  <def>MF_StandardMuzzleFalshThree</def>
                  <drawSize>(1.1,1.1)</drawSize>
                  <offsets>
                    <li>(0.85,0.00)</li>
                  </offsets>
                </li>
              </modExtensions>
            </value>
          </nomatch>
        </li>

        <!-- DMSL_Weapon_HuntingRifle（狩猎步枪） -->
        <li Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="DMSL_Weapon_HuntingRifle"]/modExtensions</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="DMSL_Weapon_HuntingRifle"]/modExtensions</xpath>
            <value>
              <li Class="MuzzleFlash.MuzzleFlashProps">
                <type>All</type>
                <def>MF_StandardMuzzleFalsh</def>
                <drawSize>(1.5,1)</drawSize>
                <offsets>
                  <li>(0.85,0.00)</li>
                </offsets>
              </li>
            </value>
          </match>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="DMSL_Weapon_HuntingRifle"]</xpath>
            <value>
              <modExtensions>
                <li Class="MuzzleFlash.MuzzleFlashProps">
                  <type>All</type>
                  <def>MF_StandardMuzzleFalsh</def>
                  <drawSize>(1.5,1)</drawSize>
                  <offsets>
                    <li>(0.85,0.00)</li>
                  </offsets>
                </li>
              </modExtensions>
            </value>
          </nomatch>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
