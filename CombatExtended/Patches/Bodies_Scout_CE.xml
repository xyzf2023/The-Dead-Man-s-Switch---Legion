	<Operation Class="PatchOperationConditional">
		<xpath>Defs/BodyDef[defName="DMSL_MechanicsCavalryman_TypeA"]/corePart/groups</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/BodyDef[defName="DMSL_MechanicsCavalryman_TypeA"]/corePart</xpath>
			<value><groups /></value>
		</nomatch>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/BodyDef[defName="DMSL_MechanicsCavalryman_TypeA"]/corePart/groups</xpath>
		<value><li>CoveredByNaturalArmor</li></value>
	</Operation>

