	<!-- ========== CE 载具炮塔开火适配 ==========
		 未加 CETurretDataDefModExtension 且弹药非 CE AmmoDef 时，VF 走 FireTurretCE 会因 loadedAmmo 强转失败报 InvalidCastException。
		 为以下炮塔添加 CE 扩展并替换为 CE 弹药，使 FireTurretCE 与 LaunchProjectileCE 收到正确类型。 -->

	<!-- DMSL_AAcannon：.50 BMG -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/Vehicles.VehicleTurretDef[defName="DMSL_AAcannon"]</xpath>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace">
					<xpath>Defs/Vehicles.VehicleTurretDef[defName="DMSL_AAcannon"]/genericAmmo</xpath>
					<value><genericAmmo>false</genericAmmo></value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/Vehicles.VehicleTurretDef[defName="DMSL_AAcannon"]/projectile</xpath>
					<value><projectile>Bullet_50BMG_FMJ</projectile></value>
				</li>
				<li Class="PatchOperationReplace">
					<xpath>Defs/Vehicles.VehicleTurretDef[defName="DMSL_AAcannon"]/ammunition/thingDefs</xpath>
					<value>
						<thingDefs>
							<li>Ammo_50BMG_FMJ</li>
							<li>Ammo_50BMG_AP</li>
							<li>Ammo_50BMG_HE</li>
							<li>Ammo_50BMG_Incendiary</li>
						</thingDefs>
					</value>
				</li>
				<li Class="PatchOperationAddModExtension">
					<xpath>Defs/Vehicles.VehicleTurretDef[defName="DMSL_AAcannon"]</xpath>
					<value>
						<li Class="Vehicles.CETurretDataDefModExtension">
							<ammoSet>AmmoSet_50BMG</ammoSet>
							<shotHeight>1</shotHeight>
							<speed>900</speed>
							<sway>0.5</sway>
							<spread>0.1</spread>
						</li>
					</value>
				</li>
			</operations>
		</match>
	</Operation>

