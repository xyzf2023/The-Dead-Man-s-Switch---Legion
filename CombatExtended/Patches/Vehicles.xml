<!-- CE 载具炮塔补丁：使用 Conditional 避免 xpath 未匹配时报错（载具 def 可能因加载顺序尚未就绪） -->
<Patch>
	<!-- Gray Knights MBT -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/Vehicles.VehicleDef[defName="DMS_GrayKnights_MainBattleTank"]/statBases</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/Vehicles.VehicleDef[defName="DMS_GrayKnights_MainBattleTank"]/statBases</xpath>
			<value>
				<statBases>
					<ArmorRating_Blunt>60</ArmorRating_Blunt>
					<ArmorRating_Sharp>25</ArmorRating_Sharp>
					<Flammability>0</Flammability>
					<MarketValue>2240</MarketValue>
				</statBases>
			</value>
		</match>
	</Operation>

	<!-- Adjust components armor -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/Vehicles.VehicleDef[defName="DMS_GrayKnights_MainBattleTank"]/components/li[key="FrontArmorPlating"]/armor</xpath>
		<match Class="PatchOperationReplace">
			<xpath>Defs/Vehicles.VehicleDef[defName="DMS_GrayKnights_MainBattleTank"]/components/li[key="FrontArmorPlating"]/armor</xpath>
			<value>
				<armor>
					<ArmorRating_Blunt>80</ArmorRating_Blunt>
					<ArmorRating_Sharp>35</ArmorRating_Sharp>
				</armor>
			</value>
		</match>
	</Operation>

