			<!-- PartialArmorExt：覆盖从 BaseAutomatroidRace（DMS 基础 MOD CE 补丁）继承来的版本。
			     PostLoad_PostFix 只保留最后一个 PartialArmorExt，所以我们的会替代继承的。
			     仅使用原版 BodyPartDef（SightSensor/HearingSensor/SmellSensor），且仅 Sharp/Blunt（ArmorRatingBase 用 StatWorker_ArmorPartial）。
			     传感器弱点 0.25x 与 DMS 参考一致；其余 CoveredByNaturalArmor 部位自动用 pawn 完整 statBases 护甲。 -->
			<li Class="PatchOperationAddModExtension">
				<xpath>Defs/ThingDef[starts-with(defName, 'DMSL_Mech_')]</xpath>
				<value>
					<li Class="CombatExtended.PartialArmorExt">
						<stats>
							<li>
								<useStatic>false</useStatic>
								<ArmorRating_Sharp>0.25</ArmorRating_Sharp>
								<parts>
									<li>SightSensor</li>
									<li>HearingSensor</li>
									<li>SmellSensor</li>
								</parts>
							</li>
							<li>
								<useStatic>false</useStatic>
								<ArmorRating_Blunt>0.25</ArmorRating_Blunt>
								<parts>
									<li>SightSensor</li>
									<li>HearingSensor</li>
									<li>SmellSensor</li>
								</parts>
							</li>
						</stats>
					</li>
				</value>
			</li>
