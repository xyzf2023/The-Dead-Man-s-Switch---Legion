        </categories>
        <depth>Internal</depth> <!-- 组件深度：内部 -->
        <hitbox> <!-- 命中框 -->
          <cells> <!-- 占据的格子 -->
            <li>(0, -2)</li> <!-- 坐标(0, -2) -->
