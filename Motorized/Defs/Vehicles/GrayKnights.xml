<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 载具建造定义：灰骑士主战坦克蓝图 -->
  <Vehicles.VehicleBuildDef ParentName="DMS_BaseVehicleBuild">
    <!-- 建筑形态的载具，基本上与BuildingDef相同 -->
    <defName>DMS_GrayKnights_MainBattleTank_Blueprint</defName> <!-- 定义蓝图的唯一标识符 -->
    <label>灰骑士</label> <!-- 显示名称 -->
    <description>多用途重型底盘</description> <!-- 物品描述 -->
    <graphicData> <!-- 图像数据 -->
      <texPath>Vehicles/GrayKnights/vehicle</texPath> <!-- 纹理路径 -->
      <drawSize>5.5</drawSize> <!-- 绘制尺寸 -->
    </graphicData>
    <statBases> <!-- 基础属性 -->
      <MaxHitPoints>500</MaxHitPoints> <!-- 最大生命值 -->
      <WorkToBuild>20000</WorkToBuild> <!-- 建造所需工作量 -->
      <Flammability>0.05</Flammability> <!-- 可燃性 -->
    </statBases>
    <size>(3,6)</size> <!-- 物品占用格子大小 -->
    <researchPrerequisites> <!-- 研究前置条件 -->
      <li>DMS_HeavyAutomatroid</li> <!-- 需要完成的前置研究 -->
    </researchPrerequisites>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite> <!-- 建造技能要求 -->
    <costList> <!-- 建造成本清单 -->
      <EngineTurbine MayRequireAnyOf="aoba.motorization.engine,rimthunder.core">1</EngineTurbine> <!-- 涡轮引擎，可能需要特定模组 -->
      <ComponentFireControl>1</ComponentFireControl> <!-- 火控组件 -->
      <Neurocomputer>2</Neurocomputer> <!-- 神经计算机 -->
      <ComponentStamped>15</ComponentStamped> <!-- 冲压组件 -->
      <ComponentIndustrial>25</ComponentIndustrial> <!-- 工业组件 -->
      <Polyester>150</Polyester> <!-- 聚酯纤维 -->
      <DMS_Ceramics>300</DMS_Ceramics> <!-- DMS陶瓷 -->
      <Tungsteel>425</Tungsteel> <!-- 钨钢 -->
      <Steel>750</Steel> <!-- 钢材 -->
    </costList>
    <thingToSpawn>DMS_GrayKnights_MainBattleTank</thingToSpawn> <!-- 建造后生成的载具Kind,这是与建筑唯一不一样的 -->
  </Vehicles.VehicleBuildDef>
  
  <!-- 载具本体定义 -->
  <Vehicles.VehicleDef ParentName="DMS_BaseVehicle">
    <defName>DMS_GrayKnights_MainBattleTank</defName> <!-- 定义载具的唯一标识符 -->
    <label>灰骑士</label> <!-- 显示名称 -->
    <description>该载具目前服役于殖民舰队，设计上支持无人驾驶作战。不过出于对战场通信环境的考虑，后舱也预留了两名乘员的空间。</description> <!-- 物品描述 -->
    <buildDef>DMS_GrayKnights_MainBattleTank_Blueprint</buildDef> <!-- 建造该载具所需的蓝图定义 -->
    <graphicData> <!-- 图像数据 -->
      <texPath>Vehicles/GrayKnights/vehicle</texPath> <!-- 纹理路径 -->
      <drawSize>6</drawSize> <!-- 绘制尺寸 -->
    </graphicData>
    <size>(3,6)</size> <!-- 物品占用格子大小 -->
    <fillPercent>1</fillPercent> <!-- 填充百分比，影响载具占用空间 -->
    <wipesPlants>true</wipesPlants> <!-- 是否清除经过的植物 -->
    <vehicleCategory>Combat</vehicleCategory> <!-- 载具类别：战斗 -->
    <statBases> <!-- 基础属性 -->
      <ArmorRating_Blunt>1.0</ArmorRating_Blunt> <!-- 钝器护甲值 -->
      <ArmorRating_Sharp>0.8</ArmorRating_Sharp> <!-- 锐器护甲值 -->
      <Flammability>0</Flammability> <!-- 可燃性 -->
      <MarketValue>2240</MarketValue> <!-- 市场价值 -->
    </statBases>
    <vehicleStats> <!-- 载具特有属性 -->
      <Mass>2000</Mass> <!-- 重量 -->
      <MoveSpeed>10</MoveSpeed> <!-- 移动速度 -->
      <CargoCapacity>600</CargoCapacity> <!-- 载货容量 -->
      <RepairRate>0.8</RepairRate> <!-- 修理速度 -->
    </vehicleStats>
    <soundOneShotsOnEvent Inherit="false"> <!-- 单次播放音效 -->
      <li>
        <key>PawnEntered</key> <!-- 角色进入时 -->
        <value>DMS_VehicleEnter</value> <!-- 音效ID -->
      </li>
      <li>
        <key>PawnExited</key> <!-- 角色离开时 -->
        <value>DMS_VehicleEnter</value> <!-- 音效ID -->
      </li>
      <li>
        <key>IgnitionOn</key> <!-- 点火启动时 -->
        <value>DMS_MBTVehicleStart</value> <!-- 音效ID -->
      </li>
      <li>
        <key>IgnitionOff</key> <!-- 熄火关闭时 -->
        <value>DMS_MBTVehicleStop</value> <!-- 音效ID -->
      </li>
    </soundOneShotsOnEvent>
    <soundSustainersOnEvent Inherit="false"> <!-- 持续播放音效 -->
      <li>
        <start>IgnitionOn</start> <!-- 开始事件 -->
        <stop>IgnitionOff</stop> <!-- 停止事件 -->
        <value>DMS_Engine_MBT</value> <!-- 音效ID -->
      </li>
    </soundSustainersOnEvent>
    <race> <!-- 种族属性 -->
      <baseBodySize>3</baseBodySize> <!-- 基础身体大小 -->
    </race>
    <properties> <!-- 载具特性 -->
      <!-- 座位与功能 -->
      <customRoadCosts AssignDefaults="0.4" /> <!-- 道路移动成本 -->
      <worldSpeedMultiplier>2</worldSpeedMultiplier> <!-- 世界地图移动速度倍数 -->
      <winterCostMultiplier>2</winterCostMultiplier> <!-- 冬季移动成本倍数 -->
      <customHillinessCosts> <!-- 丘陵地形移动成本 -->
        <SmallHills>0.5</SmallHills> <!-- 小丘陵移动成本 -->
       <LargeHills>0.5</LargeHills>
        <Mountainous>0.5</Mountainous> <!-- 山地移动成本 -->
      </customHillinessCosts>
      <restrictToFactions> <!-- 限制派系使用 -->
        <li>DMS_Army</li> <!-- 仅DMS军队可用 -->
      </restrictToFactions>
      <vehicleJobLimitations> <!-- 载具工作限制 -->
        <li>(RepairVehicle, 4)</li> <!-- 修理载具工作，最多4人同时操作 -->
      </vehicleJobLimitations>
      <roles> <!-- 乘员角色 -->
        <li>
          <key>gunner</key> <!-- 角色键 -->
          <label>gunner</label> <!-- 角色名称 -->
          <slots>2</slots> <!-- 可容纳人数 -->
          <slotsToOperate>0</slotsToOperate> <!-- 操作载具需要的人数 -->
          <handlingTypes>Turret</handlingTypes> <!-- 操作类型：炮塔 -->
          <turretIds> <!-- 可操作的炮塔ID -->
            <li>mainTurret</li> <!-- 修正：引用实际存在的炮塔 -->
          </turretIds>
        </li>
      </roles>
    </properties>
